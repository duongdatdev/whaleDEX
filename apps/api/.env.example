NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Supported: testnet (MVP transactions), mainnet (read-only until separately approved).
DEFAULT_SUI_NETWORK=testnet
# Optional selected-network override; omit to use the shared public endpoint.
# Never expose provider credentials through NEXT_PUBLIC_* variables.
# SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
SUI_GRPC_TIMEOUT_MS=10000
