# Public: this URL can be included in browser bundles. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Keep aligned with the API DEFAULT_SUI_NETWORK; applied at build time.
NEXT_PUBLIC_DEFAULT_SUI_NETWORK=testnet
# Optional selected-network gRPC-web endpoint. Public URL only, no secret provider key.
# NEXT_PUBLIC_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_SUI_GRPC_TIMEOUT_MS=10000
